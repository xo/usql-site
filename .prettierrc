{
    "$schema": "http://json.schemastore.org/prettierrc",
    "arrowParens": "always",
    "bracketSpacing": true,
    "printWidth": 100,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "plugins": ["prettier-plugin-astro"],
    "overrides": [
        { "files": "*.astro", "options": { "parser": "astro" } },
        { "files": ["*.json", ".prettierrc"], "options": { "tabWidth": 4 } }
    ]
}
